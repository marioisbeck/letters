---
import '../styles/global.css';

const isDev = import.meta.env.DEV;
---

<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{isDev ? 'Media Status (Dev Only)' : 'Not Found'}</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #faf9f6;
            color: #2c2c2c;
            padding: 2rem;
        }
        .media-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
            gap: 1rem;
            margin-top: 1rem;
        }
        .media-item {
            background: white;
            border-radius: 8px;
            overflow: hidden;
            box-shadow: 0 4px 6px rgba(0,0,0,0.05);
            border: 1px solid #f0eadd;
        }
        .media-item img, .media-item video {
            width: 100%;
            height: 150px;
            object-fit: cover;
        }
        .media-info {
            padding: 0.75rem;
            font-size: 0.8rem;
            word-break: break-all;
        }
        .section-title {
            margin-top: 2rem;
            margin-bottom: 1rem;
            padding-bottom: 0.5rem;
            border-bottom: 2px solid #e2d5c5;
        }
    </style>
</head>
<body>
    {!isDev ? (
        <div class="max-w-6xl mx-auto text-center mt-20">
            <h1 class="text-4xl font-bold text-[#4a4238]">404</h1>
            <p class="mt-4 text-gray-600">Page not found.</p>
        </div>
    ) : (
        <div class="max-w-6xl mx-auto">
            <div class="flex justify-between items-center mb-8">
                <h1 class="text-3xl font-bold text-[#4a4238]">Media Status Dashboard</h1>
                <a href="/" class="text-[#a89f91] hover:text-[#4a4238]">Back to Home</a>
            </div>

            <div id="status-container">
                <p class="text-gray-500">Loading statuses...</p>
            </div>
        </div>
    )}

    {isDev && (
        <script is:inline>
        document.addEventListener('DOMContentLoaded', () => {
            const container = document.getElementById('status-container');
            if (!container) return;

            try {
                const stored = localStorage.getItem('mediaStatuses');
                if (!stored) {
                    container.innerHTML = '<p class="text-gray-500">No media statuses found. Go click some images!</p>';
                    return;
                }

                const statuses = JSON.parse(stored);
                const fixItems = [];
                const deleteItems = [];

                for (const [url, status] of Object.entries(statuses)) {
                    if (status === 'fix') fixItems.push(url);
                    if (status === 'delete') deleteItems.push(url);
                }

                let html = '';

                // Fix Section
                html += '<h2 class="section-title text-xl font-semibold text-yellow-600 flex items-center gap-2">';
                html += '<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>';
                html += 'Needs Fixing (' + fixItems.length + ')</h2>';
                
                if (fixItems.length === 0) {
                    html += '<p class="text-gray-500">No items need fixing.</p>';
                } else {
                    html += '<div class="media-grid">';
                    fixItems.forEach(url => {
                        html += '<div class="media-item">';
                        if (url.match(/\.(mp4|mov)$/i)) {
                            html += '<video src="' + url + '" controls muted></video>';
                        } else {
                            html += '<img src="' + url + '" alt="Needs fix" loading="lazy" />';
                        }
                        html += '<div class="media-info text-gray-600">' + url.split('/').pop() + '</div>';
                        html += '</div>';
                    });
                    html += '</div>';
                }

                // Delete Section
                html += '<h2 class="section-title text-xl font-semibold text-red-600 flex items-center gap-2 mt-12">';
                html += '<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>';
                html += 'To Delete (' + deleteItems.length + ')</h2>';
                
                if (deleteItems.length === 0) {
                    html += '<p class="text-gray-500">No items to delete.</p>';
                } else {
                    html += '<div class="media-grid">';
                    deleteItems.forEach(url => {
                        html += '<div class="media-item border-red-200">';
                        if (url.match(/\.(mp4|mov)$/i)) {
                            html += '<video src="' + url + '" controls muted></video>';
                        } else {
                            html += '<img src="' + url + '" alt="To delete" loading="lazy" />';
                        }
                        html += '<div class="media-info text-gray-600">' + url.split('/').pop() + '</div>';
                        html += '</div>';
                    });
                    html += '</div>';
                }

                // JSON Export
                html += '<h2 class="section-title text-xl font-semibold text-gray-700 mt-12">Raw Data</h2>';
                html += '<div class="bg-gray-100 p-4 rounded-lg overflow-auto text-sm font-mono">';
                html += '<pre>' + JSON.stringify(statuses, null, 2) + '</pre>';
                html += '</div>';
                html += '<button id="clear-btn" class="mt-4 px-4 py-2 bg-red-100 text-red-700 rounded hover:bg-red-200 transition-colors">Clear All Statuses</button>';

                container.innerHTML = html;

                const clearBtn = document.getElementById('clear-btn');
                if (clearBtn) {
                    clearBtn.addEventListener('click', () => {
                        if (confirm('Are you sure you want to clear all statuses?')) {
                            localStorage.removeItem('mediaStatuses');
                            window.location.reload();
                        }
                    });
                }

            } catch (e) {
                container.innerHTML = '<p class="text-red-500">Error loading statuses: ' + e.message + '</p>';
            }
        });
        </script>
    )}
</body>
</html>
