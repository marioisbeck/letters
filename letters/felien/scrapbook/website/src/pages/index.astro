---
import { getCollection } from 'astro:content';
import '../styles/global.css';

// Fetch all timeline entries and sort by date
const timelineEntries = await getCollection('timeline');
timelineEntries.sort((a, b) => new Date(a.data.date).getTime() - new Date(b.data.date).getTime());

// Group by year (Year 1: Nov 2023-Oct 2024, Year 2: Nov 2024-Oct 2025, etc.)
// Felien's birthday is Nov 5.
const getYear = (dateStr) => {
    const date = new Date(dateStr);
    const year = date.getFullYear();
    const month = date.getMonth() + 1; // 1-12
    
    // If it's before Nov 2024, it's Year 1
    if (year === 2023 || (year === 2024 && month < 11)) return 1;
    if ((year === 2024 && month >= 11) || (year === 2025 && month < 11)) return 2;
    if ((year === 2025 && month >= 11) || (year === 2026 && month < 11)) return 3;
    return 4;
};

        const years = [
    {
        id: 1,
        title: "2023 - 2024",
        subtitle: "Nov 2023 - Okt 2024",
        image: "/line_art/IMG_9021_transparent.png",
        description: "Die Ankunft, das erste Lächeln, die ersten Schritte in eine neue Welt. Willkommen in der Familie Beck."
    },
    {
        id: 2,
        title: "2024 - 2025",
        subtitle: "Nov 2024 - Okt 2025",
        image: "/line_art/IMG_9804_transparent.png",
        description: "Erste Schritte. erste Worte, neue Entdeckungen und ganz viel Persönlichkeit. Ein wahrer Wonneproppen."
    },
    {
        id: 3,
        title: "2025 - Heute",
        subtitle: "Nov 2025 - Heute",
        image: "/line_art/88C82000-977D-4C10-A435-DD0A1A770095_transparent.png",
        description: "Jeden Tag ein neues Abenteuer."
    }
];
---

<html lang="en" class="scroll-smooth">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/png" href="/media/98010eb2-f01a-475f-ada1-b4d37980d38f_transparent.png" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
        <title>Feliens Welt</title>
        <link rel="icon" type="image/png" href="/media/98010eb2-f01a-475f-ada1-b4d37980d38f_transparent.png" />
        <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Inter:wght@300;400;500&display=swap" rel="stylesheet">
        <style>
            body {
                font-family: 'Inter', sans-serif;
                background-color: #faf9f6;
                color: #2c2c2c;
            }
            .serif-font {
                font-family: 'Playfair Display', serif;
            }
            
            /* Hero Morphing Styles */
            #hero-section {
                height: 100vh;
                width: 100vw;
                transition: height 0.8s cubic-bezier(0.25, 1, 0.5, 1);
                position: relative;
            }
            body.hero-scrolled #hero-section {
                height: 40vh;
            }

            #hero-wrapper {
                position: absolute;
                top: 0;
                left: 50%;
                /* 
                  100vw / 0.4 = 250vw. 
                  We make it 250vw wide so when scaled down by 0.4 it perfectly fits 100vw.
                  This guarantees text won't wrap differently during the animation.
                */
                width: 250vw;
                height: 100vh;
                transform: translate(-50%, 5vh) scale(0.9);
                transform-origin: top center;
                transition: transform 0.8s cubic-bezier(0.25, 1, 0.5, 1);
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: flex-end; /* Push content to the bottom */
            }
            body.hero-scrolled #hero-wrapper {
                transform: translate(-50%, 4vh) scale(0.4);
            }

            #hero-image-container {
                position: absolute;
                bottom: 250px; /* Overlap with text */
                left: 0;
                width: 100%;
                height: 80vh; /* Give it plenty of height */
                display: flex;
                align-items: flex-end;
                justify-content: center;
                z-index: 0;
            }
            
            #hero-text-container {
                position: relative;
                z-index: 10;
                text-align: center;
                padding-bottom: 40px; /* Reduced from 80px to make room for arrow */
            }
            
            #hero-title {
                font-size: 120px;
                margin-bottom: 20px;
                line-height: 1.1;
                white-space: nowrap;
                /* Add a subtle text shadow so it pops when overlapping the image */
                text-shadow: 0 4px 20px rgba(250, 249, 246, 0.8), 0 0 40px rgba(250, 249, 246, 0.9);
            }
            @media (min-width: 768px) {
                #hero-title { font-size: 180px; margin-bottom: 30px; }
            }

            .hero-subtitle {
                font-size: 30px;
                margin-bottom: 30px;
                letter-spacing: 0.4em;
                white-space: nowrap;
            }
            @media (min-width: 768px) {
                .hero-subtitle { font-size: 35px; margin-bottom: 40px; }
            }
            
            #hero-arrow-container {
                opacity: 1;
                transform: translateY(0);
                transition: all 0.5s ease;
            }
            body.hero-scrolled #hero-arrow-container {
                opacity: 0;
                transform: translateY(20px);
                pointer-events: none;
            }
            
            body.hero-scrolled #timeline-section {
                opacity: 1;
                transform: translateY(0);
                pointer-events: auto;
            }
            
            body.hero-scrolled #main-footer {
                opacity: 1;
                transform: translateY(0);
                pointer-events: auto;
            }
            
            /* Horizontal scrolling */
            .horizontal-scroll {
                display: flex;
                overflow-x: auto;
                scroll-snap-type: x mandatory;
                scroll-behavior: smooth;
                -webkit-overflow-scrolling: touch;
                padding-bottom: 2rem;
            }
            
            .horizontal-scroll::-webkit-scrollbar {
                height: 8px;
            }
            .horizontal-scroll::-webkit-scrollbar-track {
                background: #f0eadd;
                border-radius: 4px;
            }
            .horizontal-scroll::-webkit-scrollbar-thumb {
                background: #cbbba6;
                border-radius: 4px;
            }
            
            .year-card {
                scroll-snap-align: center;
                flex: 0 0 calc(33.333% - 2rem); /* 3 cards fit exactly in the container minus the gap */
                min-width: 300px;
                max-width: 450px;
                transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275), box-shadow 0.4s ease;
            }
            @media (max-width: 1024px) {
                .year-card {
                    flex: 0 0 calc(50% - 1.5rem); /* 2 cards on medium screens */
                }
            }
            @media (max-width: 768px) {
                .horizontal-scroll {
                    justify-content: flex-start; /* Ensure left alignment on mobile so we can scroll to the first item */
                    padding-left: 1rem;
                    padding-right: 1rem;
                }
                .year-card {
                    flex: 0 0 85vw; /* 1 card on mobile */
                    min-width: 85vw;
                }
            }
            .year-card:hover {
                transform: translateY(-12px);
                box-shadow: 0 25px 50px -12px rgba(74, 66, 56, 0.15);
            }
        </style>
	</head>
	<body class="antialiased h-screen overflow-hidden flex flex-col">
        
        <!-- Hero Section -->
        <section id="hero-section" class="bg-[#faf9f6]">
            <!-- Wrapper that scales -->
            <div id="hero-wrapper">
                
                <!-- Background Image Container -->
                <div id="hero-image-container">
                    <img src="/media/98010eb2-f01a-475f-ada1-b4d37980d38f_transparent.png" alt="Felien" class="w-full h-full object-contain object-bottom opacity-60" />
                </div>
                
                <!-- Text Content -->
                <div id="hero-text-container">
                    <h2 class="hero-subtitle text-[#4a4238] uppercase"></h2>
                    <h1 id="hero-title" class="font-bold text-[#4a4238] serif-font italic">Felien Petra Beck</h1>
                    <h2 class="hero-subtitle text-[#4a4238] uppercase">Ein digitales Tagebuch</h2>
                    
                    <!-- Arrow moved inside the scaled wrapper so it's always perfectly below the text -->
                    <div id="hero-arrow-container" class="mt-8 flex justify-center">
                        <div id="hero-arrow" class="animate-bounce cursor-pointer">
                            <svg class="w-16 h-16 text-[#a89f91] mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
                            </svg>
                        </div>
                    </div>
                </div>
                
                <!-- Gradient overlay that scales with the wrapper -->
                <div class="absolute inset-0 bg-gradient-to-b from-transparent via-transparent to-[#faf9f6] pointer-events-none z-5"></div>
            </div>
        </section>

        <!-- Horizontal Timeline Section -->
        <section id="timeline-section" class="flex-grow pt-0 pb-12 px-4 md:px-12 max-w-[1400px] mx-auto w-full relative opacity-0 translate-y-20 transition-all duration-1000 ease-out pointer-events-none">
            <!-- Decorative line art -->
            <img src="/line_art/IMG_0438_transparent.png" class="absolute top-0 left-0 w-64 h-64 opacity-5 -rotate-6 pointer-events-none hidden lg:block" alt="Decoration" />
            <img src="/line_art/afe8ff09-80da-48f7-bc96-ae835309eb97_transparent.png" class="absolute bottom-0 right-0 w-80 h-80 opacity-5 rotate-12 pointer-events-none hidden lg:block" alt="Decoration" />
            
            <div class="text-center mb-2 relative z-10">
                <h2 class="text-3xl md:text-4xl serif-font italic text-[#4a4238] mb-4"></h2>
                <div class="w-20 h-1 bg-[#cbbba6] mx-auto rounded-full"></div>
            </div>
            
            <!-- Timeline Navigation Controls -->
            <button id="timeline-prev" class="absolute left-2 md:left-8 top-[60%] -translate-y-1/2 z-20 bg-[#faf9f6]/90 backdrop-blur-sm p-3 rounded-full shadow-md border border-[#f0eadd] text-[#a89f91] hover:text-[#4a4238] hover:bg-white transition-all transform hover:-translate-x-1 hidden">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
            </button>
            <button id="timeline-next" class="absolute right-2 md:right-8 top-[60%] -translate-y-1/2 z-20 bg-[#faf9f6]/90 backdrop-blur-sm p-3 rounded-full shadow-md border border-[#f0eadd] text-[#a89f91] hover:text-[#4a4238] hover:bg-white transition-all transform hover:translate-x-1">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
            </button>
            
            <div class="horizontal-scroll gap-6 md:gap-8 lg:gap-12 pt-2 pb-8 relative z-10 md:justify-center">
                {years.map((year) => (
                    <a href={`/year/${year.id}`} class="year-card block bg-white rounded-2xl overflow-hidden shadow-lg border border-[#f0eadd] group">
                        <div class="relative h-64 overflow-hidden bg-[#f4f1ea] flex items-center justify-center p-6">
                            <img src={year.image} alt={year.title} class="w-full h-full object-contain transition-transform duration-700 opacity-80 mix-blend-multiply" />
                        </div>
                        <div class="p-6 bg-white">
                            <h3 class="text-xl serif-font font-bold text-[#4a4238] mb-2">{year.title}</h3>
                            <p class="text-sm text-[#5a5248] leading-relaxed mb-4">{year.description}</p>
                            <div class="inline-flex items-center text-sm text-[#a89f91] font-medium group-hover:text-[#4a4238] transition-colors">
                                Erinnerungen ansehen
                                <svg class="w-5 h-5 ml-2 transform group-hover:translate-x-2 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
                                </svg>
                            </div>
                        </div>
                    </a>
                ))}
            </div>
        </section>
        
        <footer id="main-footer" class="w-full py-6 text-center text-[#a89f91] text-xs md:text-sm bg-[#faf9f6] z-20 opacity-0 translate-y-4 transition-all duration-1000 ease-out pointer-events-none border-t border-[#f0eadd]">
            <p>&copy; {new Date().getFullYear()} Familie Beck. Mit Liebe gemacht.</p>
        </footer>

        <script>
            document.addEventListener('DOMContentLoaded', () => {
                let isScrolled = false;
                const horizontalScroll = document.querySelector('.horizontal-scroll');

                const setScrolled = (scrolled) => {
                    if (isScrolled === scrolled) return;
                    isScrolled = scrolled;
                    if (scrolled) {
                        document.body.classList.add('hero-scrolled');
                    } else {
                        document.body.classList.remove('hero-scrolled');
                    }
                };

                // Handle mouse wheel
                window.addEventListener('wheel', (e) => {
                    if (!isScrolled && e.deltaY > 0) {
                        setScrolled(true);
                    } else if (isScrolled && e.deltaY < 0) {
                        // Only unmorph if we are at the start of the horizontal scroll
                        if (horizontalScroll && horizontalScroll.scrollLeft <= 0) {
                            setScrolled(false);
                        }
                    }
                }, { passive: true });

                // Handle touch for mobile
                let touchStartY = 0;
                window.addEventListener('touchstart', (e) => {
                    touchStartY = e.touches[0].clientY;
                }, { passive: true });

                window.addEventListener('touchmove', (e) => {
                    const touchEndY = e.touches[0].clientY;
                    const deltaY = touchStartY - touchEndY;
                    
                    if (!isScrolled && deltaY > 50) {
                        setScrolled(true);
                    } else if (isScrolled && deltaY < -50) {
                        if (horizontalScroll && horizontalScroll.scrollLeft <= 0) {
                            setScrolled(false);
                        }
                    }
                }, { passive: true });

                // Arrow click
                const arrow = document.getElementById('hero-arrow');
                if (arrow) {
                    arrow.addEventListener('click', () => setScrolled(true));
                }

                // Timeline Navigation
                const timelinePrev = document.getElementById('timeline-prev');
                const timelineNext = document.getElementById('timeline-next');
                
                if (timelinePrev && timelineNext && horizontalScroll) {
                    const scrollAmount = window.innerWidth * 0.8; // Roughly one card width
                    
                    timelinePrev.addEventListener('click', () => {
                        horizontalScroll.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
                    });
                    
                    timelineNext.addEventListener('click', () => {
                        horizontalScroll.scrollBy({ left: scrollAmount, behavior: 'smooth' });
                    });
                    
                    const updateTimelineButtons = () => {
                        if (horizontalScroll.scrollLeft <= 10) {
                            timelinePrev.classList.add('hidden');
                        } else {
                            timelinePrev.classList.remove('hidden');
                        }
                        
                        if (horizontalScroll.scrollLeft >= horizontalScroll.scrollWidth - horizontalScroll.clientWidth - 10) {
                            timelineNext.classList.add('hidden');
                        } else {
                            timelineNext.classList.remove('hidden');
                        }
                    };
                    
                    horizontalScroll.addEventListener('scroll', updateTimelineButtons);
                    window.addEventListener('resize', updateTimelineButtons);
                    // Initial check
                    setTimeout(updateTimelineButtons, 100);
                }
            });
        </script>
	</body>
</html>
