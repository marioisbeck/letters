---
import { getCollection } from 'astro:content';

// Fetch all timeline entries and sort by date
const timelineEntries = await getCollection('timeline');
timelineEntries.sort((a, b) => new Date(a.data.date).getTime() - new Date(b.data.date).getTime());
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Felien's World</title>
        <link href="https://fonts.googleapis.com/css2?family=Merriweather:ital,wght@0,300;0,400;0,700;1,300&family=Inter:wght@300;400;600&display=swap" rel="stylesheet">
        <style>
            body {
                font-family: 'Inter', sans-serif;
                background-color: #fcfbf9;
                color: #333;
            }
            .letter-font {
                font-family: 'Merriweather', serif;
            }
            
            /* Timeline line */
            .timeline-container::before {
                content: '';
                position: absolute;
                top: 0;
                bottom: 0;
                left: 50%;
                width: 4px;
                background-color: #e5e7eb;
                transform: translateX(-50%);
                z-index: 0;
            }
            
            @media (max-width: 768px) {
                .timeline-container::before {
                    left: 24px;
                }
            }
        </style>
	</head>
	<body class="antialiased">
        <!-- Hero Section -->
        <header class="min-h-screen flex flex-col items-center justify-center text-center px-4 relative overflow-hidden bg-rose-50">
            <div class="z-10 max-w-3xl">
                <h1 class="text-5xl md:text-7xl font-bold text-rose-900 mb-6 letter-font">The Story of Felien</h1>
                <p class="text-xl md:text-2xl text-rose-700/80 mb-10">A digital scrapbook of everyday magic and yearly reflections.</p>
                <a href="#timeline" class="inline-block px-8 py-3 bg-rose-600 text-white rounded-full font-medium hover:bg-rose-700 transition-colors shadow-lg">
                    Begin the Journey
                </a>
            </div>
            <!-- Decorative elements could go here -->
        </header>

        <!-- Timeline Section -->
        <main id="timeline" class="max-w-5xl mx-auto py-24 px-4 sm:px-6 relative">
            <div class="timeline-container relative">
                
                {timelineEntries.map((entry, index) => {
                    const isLetter = entry.data.type === 'letter';
                    const isEven = index % 2 === 0;
                    
                    return (
                        <div class={`relative z-10 mb-24 md:mb-32 flex flex-col md:flex-row ${isEven ? 'md:flex-row-reverse' : ''} items-center group`}>
                            
                            <!-- Timeline Dot -->
                            <div class="absolute left-[24px] md:left-1/2 w-6 h-6 bg-white border-4 border-rose-400 rounded-full transform -translate-x-1/2 mt-6 md:mt-0 shadow-sm z-20"></div>
                            
                            <!-- Content Box -->
                            <div class={`w-full md:w-5/12 pl-16 md:pl-0 ${isEven ? 'md:pl-12' : 'md:pr-12'}`}>
                                <div class={`p-8 rounded-2xl shadow-sm transition-all duration-300 hover:shadow-md ${isLetter ? 'bg-amber-50 border border-amber-100' : 'bg-white'}`}>
                                    
                                    <div class="text-sm font-semibold text-rose-500 mb-2 tracking-wider uppercase">
                                        {new Date(entry.data.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
                                    </div>
                                    
                                    <h2 class={`text-2xl mb-4 ${isLetter ? 'letter-font text-amber-900 font-bold' : 'font-bold text-gray-800'}`}>
                                        {entry.data.title}
                                    </h2>
                                    
                                    {/* Media Gallery */}
                                    {entry.data.media && entry.data.media.length > 0 && (
                                        <div class="mb-6 space-y-4">
                                            {entry.data.media.map((mediaFile) => {
                                                const isVideo = mediaFile.toLowerCase().endsWith('.mp4') || mediaFile.toLowerCase().endsWith('.mov');
                                                const mediaPath = `/media/${mediaFile}`;
                                                
                                                if (isVideo) {
                                                    return (
                                                        <div class="rounded-xl overflow-hidden bg-gray-100 shadow-inner">
                                                            <video controls class="w-full h-auto max-h-96 object-contain">
                                                                <source src={mediaPath} type={`video/${mediaFile.split('.').pop()}`} />
                                                                Your browser does not support the video tag.
                                                            </video>
                                                        </div>
                                                    );
                                                } else {
                                                    return (
                                                        <div class="rounded-xl overflow-hidden shadow-inner bg-gray-100 p-2 transform rotate-1 hover:rotate-0 transition-transform">
                                                            <img src={mediaPath} alt="Memory" class="w-full h-auto rounded-lg" loading="lazy" />
                                                        </div>
                                                    );
                                                }
                                            })}
                                        </div>
                                    )}
                                    
                                    {/* Text Content */}
                                    <div class={`prose prose-rose max-w-none ${isLetter ? 'letter-font text-gray-800 leading-relaxed' : 'text-gray-600'}`}>
                                        <entry.render().then(({ Content }) => <Content />)}
                                    </div>
                                    
                                </div>
                            </div>
                        </div>
                    );
                })}
                
            </div>
        </main>
        
        <footer class="bg-rose-900 text-rose-100 py-12 text-center">
            <p>Made with ❤️ for Felien</p>
        </footer>
	</body>
</html>
