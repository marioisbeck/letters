---
import { getCollection, render } from 'astro:content';
import AppStoreGallery from '../../components/AppStoreGallery';
import '../../styles/global.css';

export async function getStaticPaths() {
    return [
        { params: { year: '1' } },
        { params: { year: '2' } },
        { params: { year: '3' } },
    ];
}

const { year } = Astro.params;
const yearNum = parseInt(year);

// Fetch all timeline entries and sort by date
const timelineEntries = await getCollection('timeline');
timelineEntries.sort((a, b) => new Date(a.data.date).getTime() - new Date(b.data.date).getTime());

// Filter by year
const getYear = (dateStr) => {
    const date = new Date(dateStr);
    const y = date.getFullYear();
    const m = date.getMonth() + 1; // 1-12
    
    // If it's before Nov 2024, it's Year 1
    if (y === 2023 || (y === 2024 && m < 11)) return 1;
    if ((y === 2024 && m >= 11) || (y === 2025 && m < 11)) return 2;
    if ((y === 2025 && m >= 11) || (y === 2026 && m < 11)) return 3;
    return 4;
};

const filteredEntries = timelineEntries.filter(entry => getYear(entry.data.date) === yearNum);

const renderedEntries = await Promise.all(
    filteredEntries.map(async (entry) => {
        const { Content } = await render(entry);
        return { entry, Content };
    })
);

const yearData = {
    1: {
        title: "2023 - 2024",
        image: "/line_art/IMG_9021_transparent.png",
        description: "Die Ankunft, das erste Lächeln, die ersten Schritte in eine neue Welt. Willkommen in der Familie Beck."
    },
    2: {
        title: "2024 - 2025",
        image: "/line_art/IMG_9804_transparent.png",
        description: "Erste Schritte. erste Worte, neue Entdeckungen und ganz viel Persönlichkeit. Ein wahrer Wonneproppen."
    },
    3: {
        title: "2025 - Heute",
        image: "/line_art/88C82000-977D-4C10-A435-DD0A1A770095_transparent.png",
        description: "Jeden Tag ein neues Abenteuer."
    }
};

const currentYearData = yearData[yearNum];
---

<html lang="en" class="scroll-smooth">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/png" href="/media/98010eb2-f01a-475f-ada1-b4d37980d38f_transparent.png" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
        <title>{currentYearData.title} | Feliens Welt</title>
        <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Inter:wght@300;400;500&display=swap" rel="stylesheet">
        
        <style>
            body {
                font-family: 'Inter', sans-serif;
                background-color: #faf9f6;
                color: #2c2c2c;
            }
            .serif-font {
                font-family: 'Playfair Display', serif;
            }
            
            /* Snap scrolling container */
            .snap-container {
                height: 100vh;
                overflow-y: auto;
                overflow-x: hidden;
                scroll-snap-type: y mandatory;
                scroll-behavior: smooth;
                -webkit-overflow-scrolling: touch;
            }
            
            .snap-section {
                height: 100vh;
                scroll-snap-align: start;
                scroll-snap-stop: always;
            }

            /* Custom scrollbar */
            ::-webkit-scrollbar {
                width: 8px;
            }
            ::-webkit-scrollbar-track {
                background: #faf9f6;
            }
            ::-webkit-scrollbar-thumb {
                background: #e2d5c5;
                border-radius: 4px;
            }
            ::-webkit-scrollbar-thumb:hover {
                background: #cbbba6;
            }
            
            /* Polaroid effect */
            .polaroid {
                background: white;
                padding: 12px 12px 40px 12px;
                box-shadow: 0 10px 25px rgba(0,0,0,0.05), 0 4px 10px rgba(0,0,0,0.03);
                border: 1px solid #f0f0f0;
                transition: transform 0.3s ease;
                cursor: pointer;
            }
            .polaroid:hover {
                transform: scale(1.02) rotate(0deg) !important;
                z-index: 50;
            }
            
            /* Hide scrollbar for carousel */
            .no-scrollbar::-webkit-scrollbar {
                display: none;
            }
            .no-scrollbar {
                -ms-overflow-style: none;  /* IE and Edge */
                scrollbar-width: none;  /* Firefox */
            }
            
            /* Horizontal wheel scrolling utility */
            .wheel-scroll {
                overscroll-behavior-x: contain;
            }
        </style>
	</head>
	<body class="antialiased overflow-hidden">
        
        <!-- Navigation -->
        <nav class="fixed top-0 left-0 right-0 z-50 bg-[#faf9f6]/90 backdrop-blur-md border-b border-[#f0eadd] px-6 py-4 flex items-center justify-between md:justify-center">
            <!-- Mobile Home Button -->
            <a href="/" class="md:hidden p-2 -ml-2 rounded-full text-[#a89f91] hover:text-[#4a4238] transition-colors" title="Zurück zur Übersicht">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path></svg>
            </a>
            
            <div class="max-w-7xl mx-auto flex items-center justify-center">
                <h1 class="serif-font italic text-xl text-[#4a4238]">{currentYearData.title}</h1>
            </div>
            
            <!-- Mobile Hidden Links for Swipe Navigation -->
            <div class="hidden">
                <a href={`/year/${yearNum - 1}`} id="mobile-prev-year">Prev</a>
                <a href={`/year/${yearNum + 1}`} id="mobile-next-year">Next</a>
            </div>
            
            <!-- Empty div to balance the mobile header flexbox -->
            <div class="w-10 md:hidden"></div>
        </nav>

        <div class="snap-container pt-16 relative" id="main-scroll-container">
            <!-- Desktop Unified Navigation Controls (Hidden on Mobile) -->
            <div class="hidden md:grid fixed right-8 bottom-8 z-50 grid-cols-3 gap-1 bg-[#faf9f6]/90 backdrop-blur-md p-2 rounded-2xl shadow-lg border border-[#f0eadd] pointer-events-auto">
                <!-- Up Button -->
                <div class="col-start-2 flex justify-center">
                    <button id="nav-up" class="p-2 md:p-3 rounded-full hover:bg-white text-[#a89f91] hover:text-[#4a4238] transition-colors disabled:opacity-30 disabled:cursor-not-allowed pointer-events-auto" aria-label="Previous section">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7"></path></svg>
                    </button>
                </div>
                
                                <!-- Left Button (Previous Year) -->
                <div class="col-start-1 row-start-2 flex justify-center">
                    {yearNum > 1 ? (
                        <a href={`/year/${yearNum - 1}`} class="p-2 md:p-3 rounded-full hover:bg-white text-[#a89f91] hover:text-[#4a4238] transition-colors pointer-events-auto" title="Vorheriges Jahr">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
                        </a>
                    ) : (
                        <div class="w-10 h-10 md:w-12 md:h-12"></div>
                    )}
                </div>
                
                                <!-- Center Button (Home) -->
                <div class="col-start-2 row-start-2 flex justify-center items-center">
                    <a href="/" class="p-2 md:p-3 rounded-full hover:bg-white text-[#a89f91] hover:text-[#4a4238] transition-colors pointer-events-auto" title="Zurück zur Übersicht">
                        <svg class="w-5 h-5 md:w-6 md:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path></svg>
                    </a>
                </div>
                
                <!-- Down Button -->
                <div class="col-start-2 row-start-3 flex justify-center">
                    <button id="nav-down" class="p-2 md:p-3 rounded-full hover:bg-white text-[#a89f91] hover:text-[#4a4238] transition-colors disabled:opacity-30 disabled:cursor-not-allowed pointer-events-auto" aria-label="Next section">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                    </button>
                </div>
                
                                <!-- Right Button (Next Year) -->
                <div class="col-start-3 row-start-2 flex justify-center">
                    {yearNum < 3 ? (
                        <a href={`/year/${yearNum + 1}`} class="p-2 md:p-3 rounded-full hover:bg-white text-[#a89f91] hover:text-[#4a4238] transition-colors pointer-events-auto" title="Nächstes Jahr">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                        </a>
                    ) : (
                        <div class="w-10 h-10 md:w-12 md:h-12"></div>
                    )}
                </div>
            </div>

            <!-- Intro Section -->
            <section class="snap-section relative w-full h-[calc(100vh-4rem)] flex flex-col items-center justify-end overflow-hidden bg-[#faf9f6] pb-4">
                <!-- Background Image -->
                <div class="absolute bottom-[100px] left-0 right-0 w-full h-[60vh] flex items-end justify-center z-0 overflow-hidden">
                    <img src={currentYearData.image} alt="Background" class="w-full h-full object-contain object-bottom opacity-90 max-w-full" />
                </div>
                
                <div class="z-10 text-center px-4 relative">
                    <h1 class="text-5xl md:text-7xl font-bold text-[#4a4238] mb-2 md:mb-4 serif-font italic" style="text-shadow: 0 4px 20px rgba(250, 249, 246, 0.8), 0 0 40px rgba(250, 249, 246, 0.9);">{currentYearData.title}</h1>
                    <h2 class="text-sm md:text-base tracking-[0.2em] text-[#4a4238] uppercase mb-4 md:mb-6 max-w-2xl mx-auto leading-relaxed">{currentYearData.description}</h2>
                    
                    <div class="animate-bounce mt-4 md:mt-8">
                        <svg class="w-8 h-8 text-[#a89f91] mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
                        </svg>
                    </div>
                </div>
                
                <div class="absolute inset-0 bg-gradient-to-b from-transparent via-transparent to-[#faf9f6] pointer-events-none z-5"></div>
            </section>

            {renderedEntries.length === 0 ? (
                <section class="snap-section flex items-center justify-center">
                    <div class="text-center py-20 text-[#a89f91] serif-font italic text-2xl">
                        Noch keine Erinnerungen für dieses Jahr.
                    </div>
                </section>
            ) : (
                renderedEntries.map(({ entry, Content }, index) => {
                    const isLetter = entry.data.type === 'letter';
                    const dateObj = new Date(entry.data.date);
                    const monthNum = dateObj.getMonth() + 1;
                    const monthName = dateObj.toLocaleDateString('de-DE', { month: 'long', year: 'numeric' });
                    const mediaCount = entry.data.media ? entry.data.media.length : 0;
                    const isEven = index % 2 === 0;
                    
                    return (
                        <section data-month={monthNum} data-type={isLetter ? 'letter' : 'month'} class={`snap-section w-full flex items-center justify-center p-8 md:p-16 ${isLetter ? 'bg-[#f4f1ea]' : 'bg-[#faf9f6]'}`}>
                            <div class={`max-w-7xl w-full h-full max-h-[85vh] flex flex-col ${isEven ? 'md:flex-row' : 'md:flex-row-reverse'} gap-12 md:gap-24 items-center`}>
                                
                                <!-- Content Side -->
                                <div class="w-full md:w-1/2 h-full flex flex-col overflow-y-auto pr-4 pb-8">
                                    <div class="pt-4 pb-6">
                                        <div class="text-sm font-medium tracking-[0.2em] text-[#b3a89a] uppercase mb-3">
                                            {isLetter ? 'Geburtstagsbrief' : monthName}
                                        </div>
                                        <h2 class={`text-3xl md:text-4xl mb-6 text-[#3d362e] ${isLetter ? 'serif-font italic' : 'font-semibold'}`}>
                                            {entry.data.title}
                                        </h2>
                                        <div class="w-12 h-1 bg-[#dcd3c6] mb-8"></div>
                                    </div>
                                    
                                    <div class={`prose prose-base max-w-none prose-headings:serif-font prose-headings:text-[#4a4238] prose-p:text-[#5a5248] prose-p:leading-relaxed ${isLetter ? 'serif-font text-lg' : 'text-[0.95rem]'}`}>
                                        <Content />
                                        {isLetter && entry.data.pdf && (
                                            <div class="mt-8">
                                                <a href={entry.data.pdf} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-6 py-3 bg-[#4a4238] text-[#faf9f6] rounded-full hover:bg-[#3d362e] transition-colors serif-font text-lg shadow-md hover:shadow-lg transform hover:-translate-y-0.5 transition-all no-underline">
                                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
                                                    Lesen
                                                </a>
                                            </div>
                                        )}
                                    </div>
                                </div>
                                
                                <!-- Media Side -->
                                <div class="w-full md:w-1/2 h-full flex items-center justify-center relative min-h-[40vh] pointer-events-auto overflow-hidden">
                                    {isLetter && entry.data.line_art ? (
                                        <div class="w-full h-full flex items-center justify-center p-8">
                                            <img src={entry.data.line_art} alt="Line Art" class="max-w-full max-h-[60vh] object-contain opacity-80 mix-blend-multiply drop-shadow-sm" />
                                        </div>
                                    ) : mediaCount > 0 && (
                                        <AppStoreGallery 
                                            client:load
                                            items={entry.data.media.map((mediaFile, mIndex) => {
                                                    const isVideo = mediaFile.toLowerCase().endsWith('.mp4') || mediaFile.toLowerCase().endsWith('.mov');
                                                    const mediaPath = `/media/${mediaFile}`;
                                                    const rotations = ['-rotate-2', 'rotate-1', '-rotate-1', 'rotate-2'];
                                                    const rotation = rotations[mIndex % rotations.length];
                                                    return {
                                                        id: `${entry.id}-${mIndex}`,
                                                        url: mediaPath,
                                                        type: isVideo ? 'video' : 'image',
                                                        rotation: rotation
                                                };
                                            })}
                                        />
                                    )}
                                </div>
                                
                            </div>
                        </section>
                    );
                })
            )}
            
            <section class="flex flex-col items-center justify-center text-center px-4 bg-[#4a4238] text-[#f4f1ea] relative overflow-hidden h-[35vh] min-h-[35vh]" style="scroll-snap-align: start; scroll-snap-stop: always;">
                <!-- Decorative Line Art -->
                <img src="/line_art/emoji_heart.png" class="absolute top-8 left-8 w-16 h-16 opacity-10 -rotate-12" alt="Heart" />
                <img src="/media/98010eb2-f01a-475f-ada1-b4d37980d38f_transparent.png" class="absolute bottom-0 right-0 h-48 w-auto object-contain opacity-10 rotate-6 translate-y-4 translate-x-4" style="filter: brightness(0) invert(1);" alt="Decoration" />
                
                <div class="max-w-2xl mx-auto z-10">
                    <h2 class="text-3xl md:text-4xl serif-font italic mb-6 text-[#e2d5c5]">Fortsetzung folgt...</h2>
                    
                    <div class="relative py-6 px-6">
                        <div class="absolute top-0 left-1/2 w-12 h-px bg-[#a89f91] -translate-x-1/2"></div>
                        <p class="text-base md:text-lg font-light leading-relaxed italic text-[#cbbba6]">
                            "Wir freuen uns auf all die Abenteuer, die vor uns liegen. Es gibt noch so viel zusammen zu entdecken, zu lernen und gemeinsam zu erleben. Wir können es kaum erwarten, zu sehen, wie du weiter die Welt erkundest."
                        </p>
                        <div class="absolute bottom-0 left-1/2 w-12 h-px bg-[#a89f91] -translate-x-1/2"></div>
                    </div>
                    
                    <p class="mt-6 text-xs tracking-widest uppercase text-[#a89f91]">Mama & Papa</p>
                </div>
            </section>
        </div>
        
        <script>
            document.addEventListener('DOMContentLoaded', () => {
                // Keyboard navigation for years
                document.addEventListener('keydown', (e) => {
                    if (e.key === 'ArrowLeft') {
                        const prevBtn = document.querySelector('a[title="Vorheriges Jahr"]');
                        if (prevBtn) prevBtn.click();
                    } else if (e.key === 'ArrowRight') {
                        const nextBtn = document.querySelector('a[title="Nächstes Jahr"]');
                        if (nextBtn) nextBtn.click();
                    }
                });

                // Carousel Navigation
                document.querySelectorAll('.carousel-wrapper').forEach(wrapper => {
                    const scrollArea = wrapper.querySelector('.carousel-scroll-area');
                    const btnPrev = wrapper.querySelector('.carousel-prev');
                    const btnNext = wrapper.querySelector('.carousel-next');
                    
                    if (!scrollArea) return;

                    const scrollAmount = 280; // approximate width of a polaroid + gap

                    if (btnPrev) {
                        btnPrev.addEventListener('click', () => {
                            scrollArea.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
                        });
                    }
                    
                    if (btnNext) {
                        btnNext.addEventListener('click', () => {
                            scrollArea.scrollBy({ left: scrollAmount, behavior: 'smooth' });
                        });
                    }
                });

                // Vertical Navigation Logic
                const scrollContainer = document.getElementById('main-scroll-container');
                const sections = document.querySelectorAll('.snap-section');
                const btnUp = document.getElementById('nav-up');
                const btnDown = document.getElementById('nav-down');
                
                let currentSectionIndex = 0;

                const updateYearLinks = () => {
                    const currentSection = sections[currentSectionIndex];
                    const month = currentSection?.getAttribute('data-month');
                    const type = currentSection?.getAttribute('data-type');
                    
                    const prevBtn = document.querySelector('a[title="Vorheriges Jahr"]');
                    const nextBtn = document.querySelector('a[title="Nächstes Jahr"]');
                    
                    let hash = '';
                    if (type === 'letter') {
                        hash = '#letter';
                    } else if (month) {
                        hash = `#month-${month}`;
                    }
                    
                    if (prevBtn) {
                        const url = new URL(prevBtn.href);
                        url.hash = hash;
                        prevBtn.href = url.toString();
                    }
                    if (nextBtn) {
                        const url = new URL(nextBtn.href);
                        url.hash = hash;
                        nextBtn.href = url.toString();
                    }
                };

                const updateNavButtons = () => {
                    btnUp.disabled = currentSectionIndex === 0;
                    btnDown.disabled = currentSectionIndex === sections.length - 1;
                };

                const scrollToSection = (index) => {
                    if (index >= 0 && index < sections.length) {
                        sections[index].scrollIntoView({ behavior: 'smooth' });
                        currentSectionIndex = index;
                        updateNavButtons();
                        updateYearLinks();
                    }
                };

                btnUp.addEventListener('click', () => scrollToSection(currentSectionIndex - 1));
                btnDown.addEventListener('click', () => scrollToSection(currentSectionIndex + 1));

                // Update current index on manual scroll
                let scrollTimeout;

                scrollContainer.addEventListener('scroll', () => {
                    clearTimeout(scrollTimeout);
                    scrollTimeout = setTimeout(() => {
                        const scrollPosition = scrollContainer.scrollTop;
                        const windowHeight = window.innerHeight;
                        currentSectionIndex = Math.round(scrollPosition / windowHeight);
                        updateNavButtons();
                        updateYearLinks();
                    }, 100);
                });

                // Initial button state
                updateNavButtons();
                updateYearLinks();
                
                // Add touch swipe handling for mobile year navigation
                let touchStartX = 0;
                let touchEndX = 0;
                
                document.addEventListener('touchstart', e => {
                    touchStartX = e.changedTouches[0].screenX;
                }, { passive: true });

                document.addEventListener('touchend', e => {
                    touchEndX = e.changedTouches[0].screenX;
                    handleSwipe(e);
                }, { passive: true });

                const handleSwipe = (e) => {
                    const swipeThreshold = 50; // Lower threshold for easier swiping
                    const swipeDistance = touchEndX - touchStartX;
                    
                    // Don't trigger swipe if we're interacting with a carousel or modal
                    if (document.querySelector('#media-modal:not(.hidden)') || 
                        (e && e.target && e.target.closest('.carousel-scroll-area'))) {
                        return;
                    }

                    // Get current year from URL robustly
                    const match = window.location.pathname.match(/\/year\/(\d+)/);
                    const currentYear = match ? parseInt(match[1]) : 1;

                    if (swipeDistance > swipeThreshold) {
                        // Swiped right -> go to previous year
                        if (currentYear > 1) {
                            window.location.href = `/year/${currentYear - 1}`;
                        }
                    } else if (swipeDistance < -swipeThreshold) {
                        // Swiped left -> go to next year
                        if (currentYear < 3) {
                            window.location.href = `/year/${currentYear + 1}`;
                        }
                    }
                };

                // Handle initial hash for month navigation
                if (window.location.hash) {
                    if (window.location.hash === '#letter') {
                        let targetIndex = -1;
                        
                        // Try to find a letter section
                        sections.forEach((sec, index) => {
                            if (sec.getAttribute('data-type') === 'letter') {
                                targetIndex = index;
                            }
                        });
                        
                        // If no letter found, try to find January (month 1)
                        if (targetIndex === -1) {
                            sections.forEach((sec, index) => {
                                if (sec.getAttribute('data-month') === '1' && sec.getAttribute('data-type') !== 'letter') {
                                    targetIndex = index;
                                }
                            });
                        }
                        
                        if (targetIndex !== -1) {
                            setTimeout(() => scrollToSection(targetIndex), 100);
                        }
                    } else if (window.location.hash.startsWith('#month-')) {
                        const targetMonth = parseInt(window.location.hash.replace('#month-', ''));
                        if (!isNaN(targetMonth)) {
                            const getMonthIndex = (m) => (m - 11 + 12) % 12;
                            const targetMapped = getMonthIndex(targetMonth);
                            
                            let targetIndex = -1;
                            let minDiff = 999;
                            
                            sections.forEach((sec, index) => {
                                const m = sec.getAttribute('data-month');
                                const t = sec.getAttribute('data-type');
                                if (m && t !== 'letter') {
                                    const diff = Math.abs(getMonthIndex(parseInt(m)) - targetMapped);
                                    if (diff < minDiff) {
                                        minDiff = diff;
                                        targetIndex = index;
                                    }
                                }
                            });
                            
                            if (targetIndex !== -1) {
                                setTimeout(() => scrollToSection(targetIndex), 100);
                            }
                        }
                    }
                }
            });
        </script>

        <footer class="hidden">
            <!-- Removed old footer -->
        </footer>
	</body>
</html>
